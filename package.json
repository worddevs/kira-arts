{
  "name": "kira-arts",
  "version": "1.4.0",
  "description": "TypeScript library to generate Discord-style profile, welcome and achievement cards",
  "keywords": [
    "discord",
    "discordjs",
    "canvas",
    "card",
    "profile-card",
    "image-generation",
    "typescript"
  ],
  "homepage": "https://guide.worddevs.dev/docs/kira-arts",
  "bugs": {
    "url": "https://github.com/worddevs/kira-arts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worddevs/kira-arts.git"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/worddevs"
    }
  ],
  "license": "Apache-2.0",
  "author": "worddevs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown && copyfiles \"Public/**/*\" dist",
    "lint": "eslint Src --ext .ts",
    "format": "prettier --write \"Src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "verify": "npm run format && npm run lint && npm run build && npm run test && npm run test:coverage"
  },
  "peerDependencies": {
    "discord.js": "^14.27.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "copyfiles": "^2.4.1",
    "discord.js": "^14.27.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
